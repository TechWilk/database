{
    "name": "techwilk/database",
    "description": "Simple PDO/MySQLi/SQLite wrapper to make performing SQL queries easier",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TechWilk\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TechWilk\\Database\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Christopher Wilkinson",
            "email": "c@wilk.tech"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "ext-mysqli":  "*",
        "friendsofphp/php-cs-fixer": "^3.16",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^1.2"
    },
    "scripts": {
        "test": "phpunit",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process"
    }
}
